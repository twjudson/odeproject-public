<prefigure xmlns="https://prefigure.org"
           label="secondorder01-harmonic-phase-m4b4k1">
    <diagram dimensions="(300,300)" margins="35">
            <definition>f(t) = (2*(1+t)*exp(-t/2),(1-t)*exp(-t/2))</definition>

            <coordinates bbox="[-3, -3, 3, 3]">
              <grid-axes xlabel="x" ylabel="v"/>
              <parametric-curve
                function = "f" domain="(0,10)"
                N="500"
                stroke="blue"
                thickness="1.5"/>
            </coordinates>

          </diagram>
</prefigure>