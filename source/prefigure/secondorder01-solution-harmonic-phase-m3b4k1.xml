<prefigure xmlns="https://prefigure.org"
  label="secondorder01-harmonic-phase-m3b4k1">
  <diagram dimensions="(300,300)" margins="35">
    <definition>f(t) = ((9/2)*exp(-t/3) - (5/2)*exp(-t),-(3/2)*exp(-t/3) + (5/2)*exp(-t))</definition>

    <coordinates bbox="[-3, -3, 3, 3]">
      <grid-axes xlabel="x" ylabel="v"/>
      <parametric-curve
        function = "f" domain="(0,10)"
        N="500"
        stroke="blue"
        thickness="1.5"/>
    </coordinates>

  </diagram>
</prefigure>