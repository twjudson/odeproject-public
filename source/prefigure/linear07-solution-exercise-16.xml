                    <definition>h(x)=0</definition>
                    <graph function="h" stroke="red" thickness="3"/>


                      <label anchor="(0,3)" scale="0.8">
                            <it>Saddle</it>
                      </label>

                        <label anchor="(0,-3)" scale="0.8">
                            <it>Saddle</it>
                      </label>

                    <label anchor="(2.5,1.3)" scale="0.8">
                            <it>Nodal Source</it>
                      </label>

                      <label anchor="(-2.5,1.3)" scale="0.8">
                            <it>Nodal Sink</it>
                      </label>

                      <label anchor="(2.5,-1.3)" scale="0.8">
                            <it>Nodal Source</it>
                      </label>

                      <label anchor="(-2.5,-1.3)" scale="0.8">
                            <it>Nodal Sink</it>
                      </label>

                      <label anchor="(2.5,0.2)" scale="0.8">
                            <it>Source (unstable line)</it>
                      </label>

                      <label anchor="(-2.5,0.2)" scale="0.8">
                            <it>Sink (stable line)</it>
