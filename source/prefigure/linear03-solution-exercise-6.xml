<prefigure xmlns="https://prefigure.org"
             label="linear-3-exercise-6">

<diagram dimensions="(300,300)" margins="12">
  <definition>f(t,y) = (10*y[0] + 12*y[1],-4*y[0] - 4*y[1])</definition>
  <coordinates bbox="[-4,-4,4,4]">

    <grid-axes xlabel="x(t)" ylabel="y(t)"/>
    <slope-field function="f" system="yes" stroke="black"
     arrows="yes" thickness="1" spacings="((-4,1/2,4),(-4,1/2,4))"/>
    
    <plot-de-solution function="f" t0="0" t1="4" 
          y0="(-2,1.6)" axes="(y0,y1)" arrows="1" stroke="blue"/>

    <plot-de-solution function="f" t0="0" t1="4" 
      y0="(2, -1.6)" axes="(y0,y1)" arrows="1" stroke="blue"/>

    <plot-de-solution function="f" t0="0" t1="4" 
      y0="(-2,1.2)" axes="(y0,y1)" arrows="1" stroke="blue"/>

    <plot-de-solution function="f" t0="0" t1="4" 
      y0="(2,-1.2)" axes="(y0,y1)" arrows="1" stroke="blue"/>

    <line endpoints="((4,-2), (-4,2))" thickness="3"/>
    <line endpoints="((6,-4), (-6,4))" thickness="3"/>
    <vector v="(2,-1)" stroke="red" thickness="3"/>
    <vector v="(3,-2)" stroke="red" thickness="3"/>
</coordinates>
    

  </diagram>
</prefigure>