<prefigure xmlns="https://prefigure.org"
                 label="secondorder04-solution-gain">
    <diagram dimensions="(300,300)" margins="5">
      <definition>D1 = 0.2</definition>
      <definition> G02(s) = 1/sqrt((1 - s^2)^2 + D1^2*s^2)</definition>
      
      <definition>D2 = 0.5</definition>
      <definition> G05(s) = 1/sqrt((1 - s^2)^2 + D2^2*s^2)</definition>

      <definition>D3 = 1.0</definition>
      <definition> G10(s) = 1/sqrt((1 - s^2)^2 + D3^2*s^2)</definition>

      <definition>D4 = 1.5</definition>
      <definition> G15(s) = 1/sqrt((1 - s^2)^2 + D4^2*s^2)</definition>

    <coordinates bbox="[0, 0, 6, 6]">
    <grid-axes xlabel="s" ylabel="\omega_0^2 G"/>

        <graph at="D02" N="200" function="G02" stroke = "blue"/>
        <graph at="D05" N="200"  function="G05" stroke = "green"/>
        <graph at="D10"  N="200" function="G10" stroke = "red"/>
        <graph at="D15"  N="200" function="G15" stroke = "purple"/>

    <legend at="legend" anchor="(bbox[2], bbox[3])"
    alignment="sw" scale="0.8" opacity="0.5">
    <item ref="D02"><m>D = 0.2</m></item>
    <item ref="D05"><m>D = 0.5</m></item>
    <item ref="D10"><m>D = 1.0</m></item>
    <item ref="D15"><m>D = 1.5</m></item>
    </legend>
    </coordinates>

    </diagram>
</prefigure>