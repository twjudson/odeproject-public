<prefigure xmlns="https://prefigure.org"
           label="gradient-S-levelsets">
    <diagram dimensions="(300,300)" margins="25">
      <definition>f(t,y) = (2*y[0], 6* y[1]^2)</definition>
      <coordinates bbox="[-5,-5,5,5]">
        <grid-axes xlabel="x(t)" ylabel="y(t)"/>

        <definition>gap = 1/2</definition>
        <slope-field function="f" system="yes" stroke="black"
         arrows="yes" thickness="1" spacings="((-5,gap,5),(-5,gap,5))"/>

        <definition>S(x,y) = x^2 - 2*y^2</definition>
        <implicit-curve function="S" k="1" stroke="red" />
        <implicit-curve function="S" k="2" stroke="green" />
        <implicit-curve function="S" k="3" stroke="purple" />
        <implicit-curve function="S" k="4" stroke="orange" />
        <implicit-curve function="S" k="5" stroke="blue" />
      </coordinates>

      
    </diagram>
</prefigure>