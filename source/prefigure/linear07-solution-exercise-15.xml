                <prefigure xmlns="https://prefigure.org"
                             label="trace-determinant-solution-15">

                <diagram dimensions="(300,250)" margins="(35,35,50,35)">
                  <coordinates bbox="(-4, -4, 4, 4)">
                    <axes decorations="no">
                      <xlabel><m>\alpha</m></xlabel>
                      <ylabel><m>\beta</m></ylabel>
                    </axes>

                    <definition>f(x)=0</definition>
                    <graph function="f" stroke="red" thickness="3"/>

                    <definition>g(x)=-x^2/2</definition>
                    <graph function="g" stroke="red" thickness="3"/>

                    <line endpoints="((0,-4), (0,0))" stroke="red" thickness="3"/>

                      <label anchor="(0,2)" scale="0.8">
                            <it>Saddle</it>
                      </label>

                      <label anchor="(0,-2)" scale="0.8">
                            <it>Center</it>
                      </label>

                      <label anchor="(3,-1)" scale="0.8">
                            <it>Spiral Source</it>
                      </label>

                      <label anchor="(-3,-1)" scale="0.8">
                            <it>Spiral Sink</it>
                      </label>

                      <label anchor="(1.2,-3)" scale="0.8">
                            <it>Nodal Source</it>
                      </label>

                      <label anchor="(-1.2,-3)" scale="0.8">
                            <it>Nodal Sink</it>
                      </label>

                      <label anchor="(2.5,-2)" scale="0.8">
                            <it>Source (unstable line)</it>
                      </label>

                      <label anchor="(-2,-2)" scale="0.8">
                            <it>Sink (stable line)</it>
                      </label>

                  </coordinates>

                </diagram>

                </prefigure>
