<prefigure xmlns="https://prefigure.org"
           label="secondorder01-harmonic-phase-m1b2k3">

  <diagram dimensions="(300,300)" margins="35">
        <definition>f(t) = (exp(-t)*(-3*cos(sqrt(2)*t) + (sqrt(2)/2)*sin(sqrt(2)*t)),exp(-t)*(4*cos(sqrt(2)*t) + (5*sqrt(2)/2)*sin(sqrt(2)*t)))</definition>

        <coordinates bbox="[-5, -5, 5, 5]">
          <grid-axes xlabel="x" ylabel="v"/>
          <parametric-curve
            function = "f" domain="(0,10)"
            N="500"
            stroke="blue"
            thickness="1.5"/>
        </coordinates>

      </diagram>
</prefigure>