<prefigure xmlns="https://prefigure.org"
                   label="linear-3-exercise-3">


  <diagram dimensions="(300,300)" margins="12">
    <definition>f(t,y) = (-9*y[0] - 2*y[1],10*y[0])</definition>
    <coordinates bbox="[-5,-5,5,5]">

      <grid-axes xlabel="x(t)" ylabel="y(t)"/>
      <slope-field function="f" system="yes" stroke="black"
       arrows="yes" thickness="1" spacings="((-5,1,5),(-5,1,5))"/>
      
      <plot-de-solution function="f" t0="0" t1="4" 
            y0="(-1,5)" axes="(y0,y1)" arrows="1" stroke="blue"/>

      <plot-de-solution function="f" t0="0" t1="4" 
        y0="(1,-5)" axes="(y0,y1)" arrows="1" stroke="blue"/>

      <plot-de-solution function="f" t0="0" t1="4" 
        y0="(5,-2)" axes="(y0,y1)" arrows="1" stroke="blue"/>

      <plot-de-solution function="f" t0="0" t1="4" 
        y0="(-5,2)" axes="(y0,y1)" arrows="1" stroke="blue"/>

      <line endpoints="((2,-5), (-2,5))" thickness="3"/>
      <line endpoints="((5,-10), (-5,10))" thickness="3"/>
      <vector v="(2,-5)" stroke="red" thickness="3"/>
      <vector v="(1,-2)" stroke="red" thickness="3"/>
  </coordinates>
      

    </diagram>
      </prefigure>