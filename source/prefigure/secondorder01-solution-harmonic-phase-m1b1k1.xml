<prefigure xmlns="https://prefigure.org"
           label="secondorder01-harmonic-phase-m1b1k1">
  <diagram dimensions="(300,300)" margins="35">
    <definition>f(t) = (exp(-t/2)*(cos(sqrt(3)*t/2) + (1/sqrt(3))*sin(sqrt(3)*t/2)), -(2/sqrt(3))*exp(-t/2)*sin(sqrt(3)*t/2))</definition>

    <coordinates bbox="[-1.2, -0.8, 1.2, 0.8]">
      <grid-axes xlabel="x" ylabel="v"/>
      <parametric-curve
        function = "f" domain="(0,10)"
        N="500"
        stroke="blue"
        thickness="1.5"/>
    </coordinates>

  </diagram>
</prefigure>