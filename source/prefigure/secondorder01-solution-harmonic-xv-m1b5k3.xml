<prefigure xmlns="https://prefigure.org"
         label="secondorder01-harmonic-xv-m1b5k3">
<diagram dimensions="(300,200)" margins="35">

  <definition>r1 = (-5 + sqrt(13))/2</definition>
  <definition>r2 = (-5 - sqrt(13))/2</definition>
  <definition>c1 = (13 + 2*sqrt(13))/13</definition>
  <definition>c2 = (13 - 2*sqrt(13))/13</definition>
  <definition>x(t) = c1*exp(r1*t) + c2*exp(r2*t)</definition>
  <definition>v(t) = c1*r1*exp(r1*t) + c2*r2*exp(r2*t)</definition>

  <coordinates bbox="[0, -4, 6, 3]">
    <grid-axes xlabel="t" ylabel=""/>

    <graph at="pos" function="x" N="300"
           stroke="blue" thickness="1.5"/>
    <graph at="vel" function="v" N="300"
           stroke="red" thickness="1.5"/>

    <legend at="legend" anchor="(bbox[2], bbox[3])"
            alignment="sw" scale="0.8" opacity="0.5">
      <item ref="pos"><m>x(t)</m></item>
      <item ref="vel"><m>v(t)</m></item>
    </legend>
  </coordinates>

</diagram>
</prefigure>