<prefigure xmlns="https://prefigure.org"
  label="secondorder01-harmonic-phase-m8b4k1">
  <diagram dimensions="(300,300)" margins="35">
    <definition>f(t) = (exp(-t/4)*(2*cos(t/4) + 6*sin(t/4)),exp(-t/4)*(cos(t/4)- 2*sin(t/4)))</definition>

    <coordinates bbox="[-3, -3, 3, 3]">
      <grid-axes xlabel="x" ylabel="v"/>
      <parametric-curve
        function = "f" domain="(0,10)"
        N="500"
        stroke="blue"
        thickness="1.5"/>
    </coordinates>

  </diagram>
</prefigure>