<prefigure xmlns="https://prefigure.org"
           label="secondorder04-solution-beats-cos-10-11">
  <diagram dimensions="(300,300)" margins="35">

    <definition>f(x) = cos(10*x) - cos(11*x)</definition>
    <definition>env(x) = 2*sin(x/2)</definition>
    <definition>lenv(x) = -2*sin(x/2)</definition>

    <coordinates bbox="[0, -2.5, 4*pi, 2.5]">
      <grid-axes xlabel="t" ylabel="y" h-pi-format="yes"/>

      <graph at="fast" function="f" N="400" thickness="1"/>
      <graph at="envelope" function="env" stroke="red"/>
      <graph function="lenv" stroke="red"/>

      <legend at="legend" anchor="(bbox[2], bbox[3])"
              alignment="sw" scale="0.8" opacity="0.5">
        <item ref="fast">
          <m>y = \cos 10t - \cos 11t</m>
        </item>
        <item ref="envelope">
          <m>y = \pm 2\sin(t/2)</m>
        </item>
      </legend>
    </coordinates>

  </diagram>
</prefigure>