<prefigure xmlns="https://prefigure.org"
           label="secondorder01-harmonic-xv-m1b0k25">
  <diagram dimensions="(300,200)" margins="35">

    <definition>x(t) = 2*cos(5*t)</definition>
    <definition>v(t) = -10*sin(5*t)</definition>

    <coordinates bbox="[0, -11, 2*pi, 11]">
      <grid-axes xlabel="t" ylabel=""/>

      <graph at="pos" function="x" N="300"
             stroke="blue" thickness="1.5"/>
      <graph at="vel" function="v" N="300"
             stroke="red" thickness="1.5"/>

      <legend at="legend" anchor="(bbox[2], bbox[3])"
              alignment="sw" scale="0.8" opacity="0.5">
        <item ref="pos"><m>x(t)</m></item>
        <item ref="vel"><m>v(t)</m></item>
      </legend>
    </coordinates>

  </diagram>
</prefigure>