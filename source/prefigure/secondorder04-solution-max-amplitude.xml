<prefigure xmlns="https://prefigure.org"
           label="secondorder04-solution-max-amplitude">
  <diagram dimensions="(300,300)" margins="35">

    <definition>M(p) = 1/(p*sqrt(1 - p^2/4))</definition>

    <coordinates bbox="[0, 0, 2, 10]">
      <grid-axes xlabel="p" ylabel="M"/>
      <graph function="M" N="200" thickness="1.5"/>
    </coordinates>

  </diagram>
</prefigure>