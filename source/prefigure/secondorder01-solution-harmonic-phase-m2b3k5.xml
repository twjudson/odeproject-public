<prefigure xmlns="https://prefigure.org"
           label="secondorder01-harmonic-phase-m2b3k5">
    <diagram dimensions="(300,300)" margins="35">
            <definition>f(t) = (exp(-3*t/4)*(2*cos(sqrt(31)*t/4)
      + (2*sqrt(31)/31)*sin(sqrt(31)*t/4)),exp(-3*t/4)*(-cos(sqrt(31)*t/4)
      - (17*sqrt(31)/31)*sin(sqrt(31)*t/4)))</definition>

            <coordinates bbox="[-3, -3, 3, 3]">
              <grid-axes xlabel="x" ylabel="v"/>
              <parametric-curve
                function = "f" domain="(0,10)"
                N="500"
                stroke="blue"
                thickness="1.5"/>
            </coordinates>

          </diagram>
</prefigure>