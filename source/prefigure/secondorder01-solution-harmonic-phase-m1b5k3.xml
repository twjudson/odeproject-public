<prefigure xmlns="https://prefigure.org" label="secondorder01-harmonic-phase-m1b5k3">
<diagram dimensions="(300,300)" margins="35">
    <definition>r1 = (-5 + sqrt(13))/2</definition>
    <definition>r2 = (-5 - sqrt(13))/2</definition>
    <definition>c1 = (13 + 2*sqrt(13))/13</definition>
    <definition>c2 = (13 - 2*sqrt(13))/13</definition>
        <definition>f(t) = (c1*exp(r1*t) + c2*exp(r2*t),c1*r1*exp(r1*t) + c2*r2*exp(r2*t))</definition>

        <coordinates bbox="[-4, -4, 4, 4]">
          <grid-axes xlabel="x" ylabel="v"/>
          <parametric-curve
            function = "f" domain="(0,10)"
            N="500"
            stroke="blue"
            thickness="1.5"/>
        </coordinates>

      </diagram>
</prefigure>